# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Change this to a long random string before deploying
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary — file uploads (dashboard > Account details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: the SDK also reads CLOUDINARY_URL
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
CLOUDINARY_FOLDER=comsats-abbottabad

# Groq — campus assistant (console.groq.com/keys)
# Pick a model your key can access; list them with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# RAG retrieval
RAG_TOP_K=4
RAG_MIN_SCORE=0.05

# Chroma vector database. Start it with:
#   pip install chromadb
#   chroma run --path ./AI/data/chroma --port 8000
# If it is unreachable the backend falls back to its built-in vector store.
CHROMA_URL=http://localhost:8000
RAG_USE_CHROMA=true

# Semantic embeddings. Groq serves generation only — it has no embedding models,
# so embeddings come from a local sentence-transformer:
#   pip install fastembed flask flask-cors
#   python AI/main.py
EMBEDDINGS_URL=http://127.0.0.1:8100
RAG_USE_SEMANTIC=true
EMBED_MODEL=BAAI/bge-small-en-v1.5

# WhatsApp (whatsapp-web.js). Auto-start is off by default; the admin console can
# start the client and shows the QR, and the session is then reused.
WHATSAPP_ENABLED=false
WHATSAPP_REPLY_TO_GROUPS=false
WHATSAPP_ALLOW_UNKNOWN=true
# WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
