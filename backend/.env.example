# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Change this to a long random string before deploying
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary — file uploads (dashboard > Account details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: the SDK also reads CLOUDINARY_URL
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
CLOUDINARY_FOLDER=comsats-abbottabad

# Groq — campus assistant (console.groq.com/keys)
# Pick a model your key can access; list them with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# RAG retrieval
RAG_TOP_K=4
RAG_MIN_SCORE=0.05

# Chroma vector database. You normally do not start this by hand: `python AI/main.py`
# (npm run embed) starts it as a child process and stops it on Ctrl+C.
# Set CHROMA_AUTOSTART=false to manage it yourself instead.
CHROMA_URL=http://localhost:8000
RAG_USE_CHROMA=true
CHROMA_AUTOSTART=true

# Semantic embeddings. Groq serves generation only — it has no embedding models,
# so embeddings come from a local sentence-transformer:
#   pip install fastembed flask flask-cors
#   python AI/main.py
EMBEDDINGS_URL=http://127.0.0.1:8100
RAG_USE_SEMANTIC=true
EMBED_MODEL=BAAI/bge-small-en-v1.5

# WhatsApp (whatsapp-web.js).
# Link a device once with:  npm --prefix backend run whatsapp:pair
# A linked session auto-connects on boot regardless of this flag, so scanning is a
# one-time step. Set it to true only to force a client with no session yet.
WHATSAPP_ENABLED=false
WHATSAPP_REPLY_TO_GROUPS=false
WHATSAPP_ALLOW_UNKNOWN=true
# WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
